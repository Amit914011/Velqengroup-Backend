{
  "name": "server",
  "version": "1.0.0",
  "description": "Express + Mongoose PocketBase-compatible server and migration suite",
  "type": "module",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc",
    "migrate": "tsx scripts/migrate-from-pocketbase.ts",
    "verify": "tsx scripts/verify-migration.ts",
    "differential": "tsx scripts/differential-test.ts",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "multer": "^1.4.5-lts.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.10.7",
    "pocketbase": "^0.28.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
